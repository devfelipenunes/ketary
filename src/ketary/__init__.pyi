class Circuit:
    def register(self, name: str, wires: Iterable[SupportsIndex]) -> tuple[int, ...]: ...
    @property
    def registers(self) -> dict[str, tuple[int, ...]]: ...
    def checkpoint(self, name: str) -> Circuit: ...
    @property
    def checkpoints(self) -> dict[str, int]: ...
    @overload
    def contract(self, *, probabilities: Mapping[str, float] | None = ..., expectations: Mapping[str | Observable, float] | None = ..., normalized: bool = ..., atol: float = ...) -> Contract: ...
    @overload
    def contract(self, *, probabilities: Mapping[str, float] | None = ..., expectations: _ExpectationTargets | None = ..., normalized: bool = ..., atol: float = ...) -> Contract: ...
    def apply(self, block: Circuit, *, wires: Iterable[SupportsIndex] | None = ..., times: SupportsIndex = ...) -> Circuit: ...
    def apply_each(self, block: Circuit, *, placements: Iterable[Iterable[SupportsIndex]]) -> Circuit: ...
    def repeat(self, times: SupportsIndex) -> Circuit: ...
    def evolve(self, observable: Observable, *, time: float | ParameterExpression) -> Circuit: ...
    def compute_action_uncompute(self, compute: Circuit, action: Circuit, *, compute_wires: Iterable[SupportsIndex], action_wires: Iterable[SupportsIndex]) -> Circuit: ...
    @classmethod
    def from_symbolic(cls, template: QuantumCircuit) -> Circuit: ...
    def bind_partial(self, bindings: Mapping[Parameter, float]) -> Circuit: ...
    @classmethod
    def from_synthesized(cls, template: QuantumCircuit, *, seed: SupportsIndex = ...) -> Circuit: ...
    def control(self, *, controls: SupportsIndex = ..., control_state: SupportsIndex | None = ..., seed: SupportsIndex = ...) -> Circuit: ...
    def evolve_product(self, observable: Observable, *, time: float, steps: SupportsIndex, order: SupportsIndex = ...) -> Circuit: ...
    def expectation_jacobian(self, bindings: Mapping[Parameter, float], observables: Iterable[Observable], *, max_bytes: SupportsIndex = ...) -> tuple[tuple[float, ...], ...]: ...
    def sweep(self, **values: Iterable[float]) -> SweepPlan: ...
    def sweep_rows(self, rows: Iterable[Iterable[float]]) -> SweepPlan: ...
    @property
    def capabilities(self) -> dict[str, str | bool]: ...
    @classmethod
    def classical(cls, n: SupportsIndex, num_clbits: SupportsIndex) -> Circuit: ...
    @property
    def num_clbits(self) -> int: ...
    @overload
    def measure(self, wire: SupportsIndex, bit: SupportsIndex) -> Circuit: ...
    @overload
    def measure(self, wire: Iterable[SupportsIndex], bit: Iterable[SupportsIndex]) -> Circuit: ...
    def reset(self, wire: SupportsIndex | Iterable[SupportsIndex]) -> Circuit: ...
    def if_x(self, wire: SupportsIndex, bit: SupportsIndex, *, value: SupportsIndex = ...) -> Circuit: ...
    def if_z(self, wire: SupportsIndex, bit: SupportsIndex, *, value: SupportsIndex = ...) -> Circuit: ...
    def run_shots(self, *, shots: SupportsIndex = ..., seed: SupportsIndex | None = ..., max_bytes: SupportsIndex = ...) -> ShotResult: ...
    @classmethod
    def symbolic(cls, n: SupportsIndex) -> Circuit: ...
    @classmethod
    def from_dynamic(cls, template: QuantumCircuit) -> Circuit: ...
    def run_density(self, initial_state: DensityMatrix | None = ..., *, max_bytes: SupportsIndex = ...) -> DensityMatrix: ...
    def run_noisy(self, noise_model: Any, *, seed: SupportsIndex | None = ..., max_bytes: SupportsIndex = ...) -> DensityMatrix: ...
    def transpile_for(self, backend: BackendV2, *, optimization_level: SupportsIndex = ..., seed: SupportsIndex = ...) -> QuantumCircuit: ...
    @staticmethod
    def parameter(name: str) -> Parameter: ...
    @staticmethod
    def parameter_vector(name: str, size: SupportsIndex) -> tuple[Parameter, ...]: ...
    @property
    def parameters(self) -> tuple[Parameter, ...]: ...
    def bind(self, bindings: Mapping[Parameter, float] | Iterable[float] | None = ..., **values: float) -> Circuit: ...
    def __init__(self, n: SupportsIndex) -> None: ...
    @property
    def num_qubits(self) -> int: ...
    @property
    def wires(self) -> range: ...
    @property
    def gates(self) -> _Gates: ...
    @property
    def debug(self) -> _Debug: ...
    @property
    def test(self) -> _CircuitChecks: ...
    @property
    def resources(self) -> _Resources: ...
    @property
    def visualize(self) -> _Visualize: ...
    def compose(self, other: Circuit, *, wires: Iterable[SupportsIndex] | None = ...) -> Circuit: ...
    def append(self, gate: Gate, wires: Iterable[SupportsIndex]) -> Circuit: ...
    def inverse(self) -> Circuit: ...
    def decompose(self, *, reps: SupportsIndex = ...) -> Circuit: ...
    def optimize(self) -> Circuit: ...
    def transpile(self, *, basis_gates: Iterable[str], seed: SupportsIndex = ...) -> Circuit: ...
    def run(self, *, mode: Literal["statevector"] = ..., max_bytes: SupportsIndex = ..., initial_state: str | Result | ArrayLike | None = ...) -> Result: ...
    def run_many(self, initial_states: Iterable[str | Result | ArrayLike | None], *, max_bytes: SupportsIndex = ...) -> tuple[Result, ...]: ...
    def analyze(self) -> Result: ...
    def plan(self, *, bits: Iterable[str] = ..., paulis: Iterable[str] = ..., subsystems: Iterable[Iterable[SupportsIndex]] = ...) -> QueryPlan: ...
    def diff(self, other: Circuit, *, atol: float = ..., max_bytes: SupportsIndex = ...) -> SemanticDiffReport: ...
    def inspect(self, *, start: SupportsIndex = ..., limit: SupportsIndex = ...) -> dict[str, Any]: ...
    def h(self, q: SupportsIndex | Iterable[SupportsIndex]) -> Circuit: ...
    def x(self, q: SupportsIndex | Iterable[SupportsIndex]) -> Circuit: ...
    def y(self, q: SupportsIndex | Iterable[SupportsIndex]) -> Circuit: ...
    def z(self, q: SupportsIndex | Iterable[SupportsIndex]) -> Circuit: ...
