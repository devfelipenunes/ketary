from collections.abc import Iterable, Sequence, Mapping
from typing import Literal, SupportsIndex, Any, Self, overload
from dataclasses import dataclass
import numpy as np
from numpy.typing import ArrayLike, NDArray
from qiskit import QuantumCircuit
from qiskit.circuit import Gate, Parameter, ParameterExpression
from qiskit.quantum_info import SparsePauliOp, DensityMatrix
from qiskit.providers import BackendV2

class Observable:
    @classmethod
    def from_qiskit(cls, operator: SparsePauliOp) -> Observable: ...
    def __init__(self, terms: Mapping[str, float]) -> None: ...
    @property
    def num_qubits(self) -> int: ...
    def on(self, wires: Iterable[SupportsIndex], *, width: SupportsIndex) -> Observable: ...
    def product(self, other: Observable) -> SparsePauliOp: ...
    def commutator(self, other: Observable) -> SparsePauliOp: ...
    def anticommutator(self, other: Observable) -> Observable: ...
    def to_dict(self, num_qubits: SupportsIndex | None = ...) -> dict[str, float]: ...
    def to_qiskit(self, num_qubits: SupportsIndex | None = ...) -> SparsePauliOp: ...
    def __add__(self, other: Observable | float) -> Observable: ...
    def __radd__(self, other: Observable | float) -> Observable: ...
    def __neg__(self) -> Observable: ...
    def __sub__(self, other: Observable | float) -> Observable: ...
    def __rsub__(self, other: Observable | float) -> Observable: ...
    def __mul__(self, other: float) -> Observable: ...
    def __rmul__(self, other: float) -> Observable: ...
    def __matmul__(self, other: Observable) -> Observable: ...

def X(wire: SupportsIndex) -> Observable: ...
def Y(wire: SupportsIndex) -> Observable: ...
def Z(wire: SupportsIndex) -> Observable: ...
def I(wire: SupportsIndex = ...) -> Observable: ...

_ExpectationTargets = Mapping[str, float] | Mapping[Observable, float]

class ResourceLimit(ValueError): ...
class UnsupportedOperation(ValueError): ...

@dataclass(frozen=True)
class CheckResult:
    status: Literal["PASS", "FAIL", "UNSUPPORTED"]
    actual: float | None
    expected: float | None
    tolerance: float
    detail: str = ...
    def to_dict(self) -> dict[str, Any]: ...
    def render(self) -> str: ...
    def to_json(self) -> str: ...
    def require(self) -> CheckResult: ...
    def __bool__(self) -> bool: ...

@dataclass(frozen=True)
class VerificationReport:
    status: Literal["PASS", "FAIL", "UNSUPPORTED"]
    checks: tuple[tuple[str, CheckResult], ...]
    def to_dict(self) -> dict[str, object]: ...
    def render(self) -> str: ...
    @property
    def scope(self) -> str: ...
    def to_json(self) -> str: ...
    def require(self) -> VerificationReport: ...

class _Report(dict[str, Any]):
    @property
    def status(self) -> Literal["PASS", "FAIL", "UNSUPPORTED", "INCONCLUSIVE"]: ...
    @property
    def scope(self) -> str: ...
    def to_dict(self) -> dict[str, Any]: ...
    def to_json(self) -> str: ...
    def render(self) -> str: ...
    def require(self) -> Self: ...

class SnapshotReport(_Report):
    @property
    def checks(self) -> dict[str, Any]: ...

class ExternalVerificationReport(_Report):
    @property
    def external_equivalence(self) -> str | None: ...

class ModalOutcomeReport(_Report):
    @property
    def label(self) -> str | None: ...
    @property
    def peak_probability(self) -> float: ...

class PhaseEstimateReport(ModalOutcomeReport):
    @property
    def phase(self) -> float | None: ...

class ComparisonReport(_Report):
    @property
    def evidence(self) -> Evidence | None: ...

class OperatorMetricsReport(_Report):
    @property
    def operator_norm(self) -> float | None: ...

class SemanticDiffReport(dict[str, Any]):
    @property
    def structure_equal(self) -> bool: ...
    @property
    def operator(self) -> OperatorMetricsReport: ...
    @property
    def zero_input(self) -> dict[str, Any]: ...
    @property
    def scope(self) -> str: ...
    def to_dict(self) -> dict[str, Any]: ...
    def to_json(self) -> str: ...
    def render(self) -> str: ...

class DiagnosticReport(_Report): ...
class StatisticalReport(_Report): ...

class SweepPlan:
    def __init__(self, circuit: Circuit, values: Mapping[str, Iterable[float]]) -> None: ...
    @property
    def bindings(self) -> tuple[dict[str, float], ...]: ...
    def run(self, *, max_bytes: SupportsIndex = ...) -> tuple[Result, ...]: ...

class StatisticalContract:
    @property
    def num_clbits(self) -> int: ...
    @property
    def probabilities(self) -> tuple[tuple[str, float], ...]: ...
    @property
    def margin(self) -> float: ...
    @property
    def confidence(self) -> float: ...
    def __init__(self, num_clbits: SupportsIndex, *, probabilities: Mapping[str, float], margin: float = ..., confidence: float = ...) -> None: ...
    def verify(self, result: ShotResult) -> StatisticalReport: ...

class QueryPlan:
    @property
    def bits(self) -> tuple[str, ...]: ...
    @property
    def paulis(self) -> tuple[str, ...]: ...
    @property
    def subsystems(self) -> tuple[tuple[int, ...], ...]: ...
    def __init__(self, circuit: Circuit, *, bits: Iterable[str] = ..., paulis: Iterable[str] = ..., subsystems: Iterable[Iterable[SupportsIndex]] = ...) -> None: ...
    def estimate(self) -> dict[str, Any]: ...
    def run(self, *, initial_state: str | Result | ArrayLike | None = ..., max_bytes: SupportsIndex = ...) -> dict[str, Any]: ...

class Evidence:
    @classmethod
    def from_dict(cls, data: dict[str, Any]) -> Evidence: ...
    @classmethod
    def from_json(cls, payload: str) -> Evidence: ...
    def to_json(self) -> str: ...
    def to_dict(self) -> dict[str, Any]: ...
    def reproduce(self, *, max_bytes: SupportsIndex = ...) -> dict[str, Any]: ...
    def minimize(self, *, max_attempts: SupportsIndex = ..., max_bytes: SupportsIndex = ...) -> dict[str, Any]: ...

class Contract:
    @property
    def num_qubits(self) -> int: ...
    @property
    def probabilities(self) -> tuple[tuple[str, float], ...]: ...
    @property
    def expectations(self) -> tuple[tuple[str | Observable, float], ...]: ...
    @property
    def normalized(self) -> bool: ...
    @property
    def atol(self) -> float: ...
    @overload
    def __init__(self, num_qubits: SupportsIndex, *, probabilities: Mapping[str, float] | None = ..., expectations: Mapping[str | Observable, float] | None = ..., normalized: bool = ..., atol: float = ...) -> None: ...
    @overload
    def __init__(self, num_qubits: SupportsIndex, *, probabilities: Mapping[str, float] | None = ..., expectations: _ExpectationTargets | None = ..., normalized: bool = ..., atol: float = ...) -> None: ...
    def verify(self, result: Result) -> VerificationReport: ...
    def to_dict(self) -> dict[str, Any]: ...

@dataclass(frozen=True)
class ShotResult:
    shots: int
    num_clbits: int
    seed: int | None
    _counts: tuple[tuple[str, int], ...]
    measurements: tuple[tuple[int, int, int], ...] = ...
    backend: str = ...
    backend_version: str = ...
    @property
    def measured_bits(self) -> tuple[int, ...]: ...
    @property
    def counts(self) -> dict[str, int]: ...
    def probabilities(self) -> dict[str, float]: ...

class Result:
    def __init__(self, amplitudes: ArrayLike) -> None: ...
    @property
    def num_qubits(self) -> int: ...
    @property
    def math(self) -> _Math: ...
    @property
    def test(self) -> _Checks: ...
    @property
    def visualize(self) -> _ResultVisualize: ...
    def evidence(self, *, bits: Iterable[str] = ..., paulis: Iterable[str] = ...) -> dict[str, Any]: ...
    @overload
    def verify(self, *, probabilities: Mapping[str, float] | None = ..., expectations: Mapping[str | Observable, float] | None = ..., normalized: bool = ..., atol: float = ...) -> SnapshotReport: ...
    @overload
    def verify(self, *, probabilities: Mapping[str, float] | None = ..., expectations: _ExpectationTargets | None = ..., normalized: bool = ..., atol: float = ...) -> SnapshotReport: ...
    def sample(self, *, shots: SupportsIndex, seed: SupportsIndex | None = ..., max_outcomes: SupportsIndex = ..., wires: Iterable[SupportsIndex] | None = ...) -> dict[str, int]: ...

class _ResultVisualize:
    def histogram(self, *, k: SupportsIndex = ...) -> str: ...
    def bloch(self, wire: SupportsIndex = ...) -> dict[str, float]: ...
    def bloch_svg(self, wire: SupportsIndex = ...) -> str: ...

class _Math:
    def statevector(self, *, max_bytes: SupportsIndex = ...) -> NDArray[np.complex128]: ...
    def amplitude(self, bits: str) -> complex: ...
    def probability(self, bits: str) -> float: ...
    def probabilities(self, *, bits: Iterable[str] | None = ..., max_outcomes: SupportsIndex = ...) -> dict[str, float]: ...
    def marginal_probabilities(self, wires: Iterable[SupportsIndex], *, max_outcomes: SupportsIndex = ...) -> dict[str, float]: ...
    def explain_probability(self, bits: str) -> str: ...
    def table(self, bits: Iterable[str] | None = ..., *, max_rows: SupportsIndex = ...) -> str: ...
    def expectation(self, pauli: str | Mapping[SupportsIndex, str] | Observable) -> float: ...
    def expectations(self, observables: Iterable[str | Mapping[SupportsIndex, str] | Observable], *, max_work: SupportsIndex = ...) -> tuple[float, ...]: ...
    def density_matrix(self, wires: Iterable[SupportsIndex] | None = ..., *, max_bytes: SupportsIndex = ...) -> NDArray[np.complex128]: ...
    def purity(self, wires: Iterable[SupportsIndex] | None = ..., *, max_bytes: SupportsIndex = ...) -> float: ...
    def conditional_probability(self, event: Mapping[int, int], given: Mapping[int, int]) -> float: ...
    def schmidt(self, wires: Iterable[SupportsIndex], *, max_rank: SupportsIndex = ..., max_bytes: SupportsIndex = ...) -> NDArray[np.float64]: ...
    def trace_distance(self, target: Result | ArrayLike) -> float: ...
    def top_probabilities(self, *, k: SupportsIndex = ...) -> dict[str, float]: ...
    def observable_variance_streamed(self, terms: Mapping[str, float] | Observable, *, max_bytes: SupportsIndex = ..., max_work: SupportsIndex = ...) -> float: ...
    def observable_variance(self, terms: Mapping[str, float] | Observable, *, max_bytes: SupportsIndex = ...) -> float: ...
    def variance(self, pauli: str | Mapping[SupportsIndex, str] | Observable) -> float: ...
    def observable(self, terms: Mapping[str, float] | Observable) -> float: ...
    def dirac(self, *, max_terms: SupportsIndex = ..., atol: float = ...) -> str: ...
    def fidelity(self, target: Result | ArrayLike) -> float: ...
    def norm(self) -> float: ...
    def entropy(self, partition: Sequence[Iterable[SupportsIndex]], *, max_rank: SupportsIndex = ..., max_bytes: SupportsIndex = ...) -> float: ...

class _Checks:
    @overload
    def expectations(self, values: Mapping[str | Observable, float], *, atol: float = ...) -> VerificationReport: ...
    @overload
    def expectations(self, values: _ExpectationTargets, *, atol: float = ...) -> VerificationReport: ...
    def normalized(self, *, atol: float = ...) -> CheckResult: ...
    def probability(self, bits: str, expected: float, *, atol: float = ...) -> CheckResult: ...
    def fidelity(self, target: Result | ArrayLike, *, minimum: float = ...) -> CheckResult: ...
    def entangled(self, *, partition: Sequence[Iterable[SupportsIndex]], atol: float = ..., max_rank: SupportsIndex = ..., max_bytes: SupportsIndex = ...) -> CheckResult: ...
    def distribution(self, target: Result, *, atol: float = ...) -> CheckResult: ...
    def expectation(self, pauli: str | Mapping[SupportsIndex, str] | Observable, expected: float, *, atol: float = ...) -> CheckResult: ...
    def state(self, target: Result | ArrayLike, *, ignore_global_phase: bool = ..., atol: float = ...) -> CheckResult: ...

@dataclass(frozen=True)
class TraceStep:
    operation: str
    wires: tuple[int, ...]
    result: Result

@dataclass(frozen=True)
class TraceComparison:
    check: CheckResult
    step_index: int | None = ...
    actual_operation: str | None = ...
    reference_operation: str | None = ...
    actual_wires: tuple[int, ...] | None = ...
    reference_wires: tuple[int, ...] | None = ...
    def to_dict(self) -> dict[str, Any]: ...

@dataclass(frozen=True)
class ResourceReport:
    num_qubits: int
    gate_count: int
    depth: int
    two_qubit_gates: int
    three_plus_qubit_gates: int
    by_gate: tuple[tuple[str, int], ...]

class _Debug:
    def verify_checkpoints(self, contracts: Mapping[int | str, Contract], *, max_bytes: SupportsIndex = ..., max_steps: SupportsIndex = ...) -> DiagnosticReport: ...
    def trace(self, *, max_bytes: SupportsIndex = ..., max_steps: SupportsIndex = ...) -> tuple[TraceStep, ...]: ...
    def checkpoint(self, index: SupportsIndex | str, *, max_bytes: SupportsIndex = ..., max_steps: SupportsIndex = ...) -> TraceStep: ...
    def compare_checkpoints(self, reference: Circuit, pairs: Iterable[tuple[SupportsIndex | str, SupportsIndex | str]], *, ignore_global_phase: bool = ..., atol: float = ..., max_bytes: SupportsIndex = ..., max_steps: SupportsIndex = ...) -> DiagnosticReport: ...
    def compare(self, reference: Circuit, *, ignore_global_phase: bool = ..., atol: float = ..., max_bytes: SupportsIndex = ..., max_steps: SupportsIndex = ...) -> TraceComparison: ...

class _CircuitChecks:
    def external_equivalence(self, other: Circuit, *, deadline: float = ...) -> ExternalVerificationReport: ...
    def compare(self, other: Circuit, *, inputs: Iterable[str] | None = ..., complete: bool = ..., ignore_global_phase: bool = ..., atol: float = ..., max_bytes: SupportsIndex = ...) -> ComparisonReport: ...
    def metrics(self, other: Circuit, *, ignore_global_phase: bool = ..., atol: float = ..., max_bytes: SupportsIndex = ...) -> OperatorMetricsReport: ...
    def equivalent(self, other: Circuit, *, ignore_global_phase: bool = ..., atol: float = ..., max_bytes: SupportsIndex = ...) -> CheckResult: ...

class _Resources:
    def summary(self) -> ResourceReport: ...

class _Visualize:
    def text(self, *, max_qubits: SupportsIndex = ..., max_gates: SupportsIndex = ...) -> str: ...
    def svg(self, *, max_qubits: SupportsIndex = ..., max_gates: SupportsIndex = ...) -> str: ...

