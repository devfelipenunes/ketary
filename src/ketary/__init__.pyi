from collections.abc import Iterable, Sequence, Mapping
from typing import Literal, SupportsIndex, Any
from dataclasses import dataclass
import numpy as np
from numpy.typing import ArrayLike, NDArray
from qiskit import QuantumCircuit
from qiskit.circuit import Gate, Parameter, ParameterExpression

class ResourceLimit(ValueError): ...
class UnsupportedOperation(ValueError): ...

@dataclass(frozen=True)
class CheckResult:
    status: Literal["PASS", "FAIL", "UNSUPPORTED"]
    actual: float | None
    expected: float | None
    tolerance: float
    detail: str = ...
    def to_dict(self) -> dict[str, Any]: ...
    def require(self) -> CheckResult: ...
    def __bool__(self) -> bool: ...

@dataclass(frozen=True)
class VerificationReport:
    status: Literal["PASS", "FAIL", "UNSUPPORTED"]
    checks: tuple[tuple[str, CheckResult], ...]
    def to_dict(self) -> dict[str, object]: ...
    def render(self) -> str: ...
    def require(self) -> VerificationReport: ...

class Contract:
    @property
    def num_qubits(self) -> int: ...
    @property
    def probabilities(self) -> tuple[tuple[str, float], ...]: ...
    @property
    def expectations(self) -> tuple[tuple[str, float], ...]: ...
    @property
    def normalized(self) -> bool: ...
    @property
    def atol(self) -> float: ...
    def __init__(self, num_qubits: SupportsIndex, *, probabilities: Mapping[str, float] | None = ..., expectations: Mapping[str, float] | None = ..., normalized: bool = ..., atol: float = ...) -> None: ...
    def verify(self, result: Result) -> VerificationReport: ...

@dataclass(frozen=True)
class ShotResult:
    shots: int
    num_clbits: int
    seed: int | None
    _counts: tuple[tuple[str, int], ...]
    @property
    def counts(self) -> dict[str, int]: ...
    def probabilities(self) -> dict[str, float]: ...

class Result:
    def __init__(self, amplitudes: ArrayLike) -> None: ...
    @property
    def num_qubits(self) -> int: ...
    @property
    def math(self) -> _Math: ...
    @property
    def test(self) -> _Checks: ...
    @property
    def visualize(self) -> _ResultVisualize: ...
    def evidence(self, *, bits: Iterable[str] = ..., paulis: Iterable[str] = ...) -> dict[str, Any]: ...
    def verify(self, *, probabilities: Mapping[str, float] | None = ..., expectations: Mapping[str, float] | None = ..., normalized: bool = ..., atol: float = ...) -> dict[str, Any]: ...
    def sample(self, *, shots: SupportsIndex, seed: SupportsIndex | None = ..., max_outcomes: SupportsIndex = ..., wires: Iterable[SupportsIndex] | None = ...) -> dict[str, int]: ...

class _ResultVisualize:
    def histogram(self, *, k: SupportsIndex = ...) -> str: ...
    def bloch(self, wire: SupportsIndex = ...) -> dict[str, float]: ...
    def bloch_svg(self, wire: SupportsIndex = ...) -> str: ...

class _Math:
    def statevector(self, *, max_bytes: SupportsIndex = ...) -> NDArray[np.complex128]: ...
    def amplitude(self, bits: str) -> complex: ...
    def probability(self, bits: str) -> float: ...
    def probabilities(self, *, max_outcomes: SupportsIndex = ...) -> dict[str, float]: ...
    def marginal_probabilities(self, wires: Iterable[SupportsIndex], *, max_outcomes: SupportsIndex = ...) -> dict[str, float]: ...
    def explain_probability(self, bits: str) -> str: ...
    def table(self, bits: Iterable[str] | None = ..., *, max_rows: SupportsIndex = ...) -> str: ...
    def expectation(self, pauli: str) -> float: ...
    def density_matrix(self, wires: Iterable[SupportsIndex] | None = ..., *, max_bytes: SupportsIndex = ...) -> NDArray[np.complex128]: ...
    def purity(self, wires: Iterable[SupportsIndex] | None = ..., *, max_bytes: SupportsIndex = ...) -> float: ...
    def conditional_probability(self, event: Mapping[int, int], given: Mapping[int, int]) -> float: ...
    def schmidt(self, wires: Iterable[SupportsIndex], *, max_rank: SupportsIndex = ..., max_bytes: SupportsIndex = ...) -> NDArray[np.float64]: ...
    def trace_distance(self, target: Result | ArrayLike) -> float: ...
    def top_probabilities(self, *, k: SupportsIndex = ...) -> dict[str, float]: ...
    def observable_variance(self, terms: Mapping[str, float], *, max_bytes: SupportsIndex = ...) -> float: ...
    def variance(self, pauli: str) -> float: ...
    def observable(self, terms: Mapping[str, float]) -> float: ...
    def dirac(self, *, max_terms: SupportsIndex = ..., atol: float = ...) -> str: ...
    def fidelity(self, target: Result | ArrayLike) -> float: ...
    def norm(self) -> float: ...
    def entropy(self, partition: Sequence[Iterable[SupportsIndex]], *, max_rank: SupportsIndex = ..., max_bytes: SupportsIndex = ...) -> float: ...

class _Checks:
    def normalized(self, *, atol: float = ...) -> CheckResult: ...
    def probability(self, bits: str, expected: float, *, atol: float = ...) -> CheckResult: ...
    def fidelity(self, target: Result | ArrayLike, *, minimum: float = ...) -> CheckResult: ...
    def entangled(self, *, partition: Sequence[Iterable[SupportsIndex]], atol: float = ..., max_rank: SupportsIndex = ..., max_bytes: SupportsIndex = ...) -> CheckResult: ...
    def distribution(self, target: Result, *, atol: float = ...) -> CheckResult: ...
    def expectation(self, pauli: str, expected: float, *, atol: float = ...) -> CheckResult: ...
    def state(self, target: Result | ArrayLike, *, ignore_global_phase: bool = ..., atol: float = ...) -> CheckResult: ...

@dataclass(frozen=True)
class TraceStep:
    operation: str
    wires: tuple[int, ...]
    result: Result

@dataclass(frozen=True)
class TraceComparison:
    check: CheckResult
    step_index: int | None = ...
    actual_operation: str | None = ...
    reference_operation: str | None = ...
    actual_wires: tuple[int, ...] | None = ...
    reference_wires: tuple[int, ...] | None = ...
    def to_dict(self) -> dict[str, Any]: ...

@dataclass(frozen=True)
class ResourceReport:
    num_qubits: int
    gate_count: int
    depth: int
    two_qubit_gates: int
    three_plus_qubit_gates: int
    by_gate: tuple[tuple[str, int], ...]

class _Debug:
    def trace(self, *, max_bytes: SupportsIndex = ..., max_steps: SupportsIndex = ...) -> tuple[TraceStep, ...]: ...
    def checkpoint(self, index: SupportsIndex, *, max_bytes: SupportsIndex = ..., max_steps: SupportsIndex = ...) -> TraceStep: ...
    def compare_checkpoints(self, reference: Circuit, pairs: Iterable[tuple[SupportsIndex, SupportsIndex]], *, ignore_global_phase: bool = ..., atol: float = ..., max_bytes: SupportsIndex = ..., max_steps: SupportsIndex = ...) -> dict[str, Any]: ...
    def compare(self, reference: Circuit, *, ignore_global_phase: bool = ..., atol: float = ..., max_bytes: SupportsIndex = ..., max_steps: SupportsIndex = ...) -> TraceComparison: ...

class _CircuitChecks:
    def equivalent(self, other: Circuit, *, ignore_global_phase: bool = ..., atol: float = ..., max_bytes: SupportsIndex = ...) -> CheckResult: ...

class _Resources:
    def summary(self) -> ResourceReport: ...

class _Visualize:
    def text(self, *, max_qubits: SupportsIndex = ..., max_gates: SupportsIndex = ...) -> str: ...
    def svg(self, *, max_qubits: SupportsIndex = ..., max_gates: SupportsIndex = ...) -> str: ...

class _Gates:
    def h(self, q: SupportsIndex) -> Circuit: ...
    def x(self, q: SupportsIndex) -> Circuit: ...
    def y(self, q: SupportsIndex) -> Circuit: ...
    def z(self, q: SupportsIndex) -> Circuit: ...
    def s(self, q: SupportsIndex) -> Circuit: ...
    def sdg(self, q: SupportsIndex) -> Circuit: ...
    def t(self, q: SupportsIndex) -> Circuit: ...
    def tdg(self, q: SupportsIndex) -> Circuit: ...
    def rx(self, theta: float | ParameterExpression, q: SupportsIndex) -> Circuit: ...
    def ry(self, theta: float | ParameterExpression, q: SupportsIndex) -> Circuit: ...
    def rz(self, theta: float | ParameterExpression, q: SupportsIndex) -> Circuit: ...
    def cx(self, c: SupportsIndex, t: SupportsIndex) -> Circuit: ...
    def cz(self, c: SupportsIndex, t: SupportsIndex) -> Circuit: ...
    def swap(self, a: SupportsIndex, b: SupportsIndex) -> Circuit: ...
    def ccx(self, c1: SupportsIndex, c2: SupportsIndex, t: SupportsIndex) -> Circuit: ...

    def p(self, theta: float | ParameterExpression, q: SupportsIndex) -> Circuit: ...
    def u(self, theta: float | ParameterExpression, phi: float | ParameterExpression, lam: float | ParameterExpression, q: SupportsIndex) -> Circuit: ...
    def cp(self, theta: float | ParameterExpression, a: SupportsIndex, b: SupportsIndex) -> Circuit: ...
    def ch(self, a: SupportsIndex, b: SupportsIndex) -> Circuit: ...
    def crx(self, theta: float | ParameterExpression, a: SupportsIndex, b: SupportsIndex) -> Circuit: ...
    def cry(self, theta: float | ParameterExpression, a: SupportsIndex, b: SupportsIndex) -> Circuit: ...
    def crz(self, theta: float | ParameterExpression, a: SupportsIndex, b: SupportsIndex) -> Circuit: ...
    def sx(self, q: SupportsIndex) -> Circuit: ...
    def sxdg(self, q: SupportsIndex) -> Circuit: ...
    def cy(self, a: SupportsIndex, b: SupportsIndex) -> Circuit: ...
    def cswap(self, control: SupportsIndex, a: SupportsIndex, b: SupportsIndex) -> Circuit: ...
    def rxx(self, theta: float | ParameterExpression, a: SupportsIndex, b: SupportsIndex) -> Circuit: ...
    def ryy(self, theta: float | ParameterExpression, a: SupportsIndex, b: SupportsIndex) -> Circuit: ...
    def rzz(self, theta: float | ParameterExpression, a: SupportsIndex, b: SupportsIndex) -> Circuit: ...
    def mcx(self, controls: Iterable[SupportsIndex], target: SupportsIndex) -> Circuit: ...

class Circuit:
    @classmethod
    def classical(cls, n: SupportsIndex, num_clbits: SupportsIndex) -> Circuit: ...
    @property
    def num_clbits(self) -> int: ...
    def measure(self, wire: SupportsIndex, bit: SupportsIndex) -> Circuit: ...
    def reset(self, wire: SupportsIndex) -> Circuit: ...
    def if_x(self, wire: SupportsIndex, bit: SupportsIndex, *, value: SupportsIndex = ...) -> Circuit: ...
    def if_z(self, wire: SupportsIndex, bit: SupportsIndex, *, value: SupportsIndex = ...) -> Circuit: ...
    def run_shots(self, *, shots: SupportsIndex = ..., seed: SupportsIndex | None = ..., max_bytes: SupportsIndex = ...) -> ShotResult: ...
    @classmethod
    def symbolic(cls, n: SupportsIndex) -> Circuit: ...
    @staticmethod
    def parameter(name: str) -> Parameter: ...
    @property
    def parameters(self) -> tuple[Parameter, ...]: ...
    def bind(self, bindings: Mapping[Parameter, float]) -> Circuit: ...
    def __init__(self, n: SupportsIndex) -> None: ...
    @property
    def num_qubits(self) -> int: ...
    @property
    def gates(self) -> _Gates: ...
    @property
    def debug(self) -> _Debug: ...
    @property
    def test(self) -> _CircuitChecks: ...
    @property
    def resources(self) -> _Resources: ...
    @property
    def visualize(self) -> _Visualize: ...
    def compose(self, other: Circuit, *, wires: Iterable[SupportsIndex] | None = ...) -> Circuit: ...
    def append(self, gate: Gate, wires: Iterable[SupportsIndex]) -> Circuit: ...
    def inverse(self) -> Circuit: ...
    def decompose(self, *, reps: SupportsIndex = ...) -> Circuit: ...
    def optimize(self) -> Circuit: ...
    def transpile(self, *, basis_gates: Iterable[str], seed: SupportsIndex = ...) -> Circuit: ...
    def run(self, *, mode: Literal["statevector"] = ..., max_bytes: SupportsIndex = ..., initial_state: str | Result | ArrayLike | None = ...) -> Result: ...
    def analyze(self) -> Result: ...
    def inspect(self, *, start: SupportsIndex = ..., limit: SupportsIndex = ...) -> dict[str, Any]: ...
    def h(self, q: SupportsIndex) -> Circuit: ...
    def x(self, q: SupportsIndex) -> Circuit: ...
    def y(self, q: SupportsIndex) -> Circuit: ...
    def z(self, q: SupportsIndex) -> Circuit: ...
    def s(self, q: SupportsIndex) -> Circuit: ...
    def sdg(self, q: SupportsIndex) -> Circuit: ...
    def t(self, q: SupportsIndex) -> Circuit: ...
    def tdg(self, q: SupportsIndex) -> Circuit: ...
    def rx(self, theta: float | ParameterExpression, q: SupportsIndex) -> Circuit: ...
    def ry(self, theta: float | ParameterExpression, q: SupportsIndex) -> Circuit: ...
    def rz(self, theta: float | ParameterExpression, q: SupportsIndex) -> Circuit: ...
    def cx(self, c: SupportsIndex, t: SupportsIndex) -> Circuit: ...
    def cz(self, c: SupportsIndex, t: SupportsIndex) -> Circuit: ...
    def swap(self, a: SupportsIndex, b: SupportsIndex) -> Circuit: ...
    def ccx(self, c1: SupportsIndex, c2: SupportsIndex, t: SupportsIndex) -> Circuit: ...
    def p(self, theta: float | ParameterExpression, q: SupportsIndex) -> Circuit: ...
    def u(self, theta: float | ParameterExpression, phi: float | ParameterExpression, lam: float | ParameterExpression, q: SupportsIndex) -> Circuit: ...
    def cp(self, theta: float | ParameterExpression, a: SupportsIndex, b: SupportsIndex) -> Circuit: ...
    def ch(self, a: SupportsIndex, b: SupportsIndex) -> Circuit: ...
    def crx(self, theta: float | ParameterExpression, a: SupportsIndex, b: SupportsIndex) -> Circuit: ...
    def cry(self, theta: float | ParameterExpression, a: SupportsIndex, b: SupportsIndex) -> Circuit: ...
    def crz(self, theta: float | ParameterExpression, a: SupportsIndex, b: SupportsIndex) -> Circuit: ...
    def sx(self, q: SupportsIndex) -> Circuit: ...
    def sxdg(self, q: SupportsIndex) -> Circuit: ...
    def cy(self, a: SupportsIndex, b: SupportsIndex) -> Circuit: ...
    def cswap(self, control: SupportsIndex, a: SupportsIndex, b: SupportsIndex) -> Circuit: ...
    def rxx(self, theta: float | ParameterExpression, a: SupportsIndex, b: SupportsIndex) -> Circuit: ...
    def ryy(self, theta: float | ParameterExpression, a: SupportsIndex, b: SupportsIndex) -> Circuit: ...
    def rzz(self, theta: float | ParameterExpression, a: SupportsIndex, b: SupportsIndex) -> Circuit: ...
    def mcx(self, controls: Iterable[SupportsIndex], target: SupportsIndex) -> Circuit: ...
    @classmethod
    def from_parameterized(cls, template: QuantumCircuit, bindings: Mapping[Parameter, float]) -> Circuit: ...
    def copy(self) -> Circuit: ...
    def h_many(self, wires: Iterable[SupportsIndex]) -> Circuit: ...
    def to_qiskit(self) -> QuantumCircuit: ...
    def to_json(self) -> str: ...
    @classmethod
    def from_json(cls, payload: str) -> Circuit: ...

def from_qiskit(qc: QuantumCircuit) -> Circuit: ...
